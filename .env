# ============================================================================
# リンク脚四足ロボット シミュレーション — 設定サンプル
#
#   cp .env.example .env    してから編集してください。
#   優先順位:  コマンドライン引数 > シェルの環境変数 > .env > コード内の既定値
#   ここに書いてある値はすべてコード側の既定値と同じなので、
#   変えたい行だけ残して他は消してしまっても動きます。
# ============================================================================

# ---- Jev (外部ollama) ------------------------------------------------------
# 別マシンのollamaを使うときだけ設定 (例 http://192.168.1.50:11434)
# 未設定なら ネイティブ実行=127.0.0.1:11434 / Docker=host.docker.internal:11434
# ここに 127.0.0.1 と書くとDockerのコンテナ内でコンテナ自身を指してしまうので注意
#OLLAMA_HOST=http://127.0.0.1:11434
# 判断モデル。gemma3:4b は判断が安定しないので実用外 (README の実測表参照)
JEV_MODEL=gemma3:12b
# 判断バックエンド
#   ollama   自前のJev風実装。ollamaの /api/chat を叩く (既定)
#   localjev local-jev サーバの /v1/systemone を叩く (選択肢ごとの確率とconfidence付き)
#   mock     推論なし。同じ4択を決定論的に計算する
JEV_BRAIN=ollama
# 判断周期 [s]。推論時間に合わせるのが重要 (実測の最適値)
#   localjev + GPU : 0.5   (推論0.05〜0.07s)
#   localjev + CPU : 1.2   (推論1.0〜1.1s)
#   ollama gemma3:12b: 0.8 (推論0.40s)
# 短すぎると古い状況の判断が混ざり、長すぎると反応が遅れて接触が増える
JEV_PERIOD=0.8
# HTTPタイムアウト [s]。初回のモデルロードは数十秒かかることがある
JEV_TIMEOUT=20
# 0 = 同じ状況なら同じ判断。0.3 くらいにすると迂回する側の選び方も毎回変わる
JEV_TEMPERATURE=0
JEV_NUM_PREDICT=60
# プロンプトの作り方
#   rules = 判断ルールを書いて渡す (gemma3などの汎用モデル向け。既定)
#   bare  = 状態だけ渡す (タスク専用に作られたモデル向け。入力が短く速い)
JEV_PROMPT=rules
# 出力の縛り方
#   schema = JSONスキーマでenum固定。パース失敗が起きない (推奨)
#   json   = JSONであることだけ要求
#   off    = 自由文から行動語を拾う (制約デコードに対応しないモデル向け)
JEV_FORMAT=schema
# 1判断1行のJSONLを残す (空なら出力しない)
JEV_LOG=

# ---- local-jev バックエンド (JEV_BRAIN=localjev のとき) ---------------------
# local-jev サーバのURL。未設定なら ネイティブ実行=127.0.0.1:8765 /
# Docker=http://local-jev:8765 (composeのサービス名) になる
#LOCALJEV_URL=http://127.0.0.1:8765
# jev-latest / jev-preview / local-jev-latest はサーバの既定モデルの別名。
# 個別指定も可: nli-deberta-large (約0.9GB) / llm-qwen2.5-1.5b / llm-qwen3.5-2b /
#               llm-qwen3-4b / llm-qwen3.5-4b (約9.3GB)
LOCALJEV_MODEL=jev-latest
# サーバ側で LOCAL_JEV_API_KEY を設定している場合のみ
LOCALJEV_API_KEY=
# confidence がこれ未満なら決定論ポリシーに落とす (0 = 常にlocal-jevの答えを使う)
# local-jev の README が勧めている使い方: 高いときだけ従い、低いときは別手段へ
JEV_MIN_CONFIDENCE=0.0
# 旋回方向ヒステリシス: 反対側がこれ以上広いときだけ乗り換える [m]
JEV_HYST_MARGIN=0.10
# JEV_BRAIN=mock のときの疑似レイテンシ [s]
JEV_MOCK_LATENCY=0.05
# 疎通確認 (/api/tags, /v1/models) のタイムアウト [s]
JEV_PROBE_TIMEOUT=5

# ---- LiDAR -----------------------------------------------------------------
LIDAR_BEAMS=61
LIDAR_FOV_DEG=180
LIDAR_RANGE=2.0
LIDAR_MIN_RANGE=0.04
# 車体座標での取付位置 [m] (前端・車体中央高さ)
LIDAR_MOUNT_X=0.105
LIDAR_MOUNT_Y=0.0
LIDAR_MOUNT_Z=0.115
# これ未満を BLOCKED と判定 [m]。車体幅0.23m + 判断周期中に進む0.18m の余裕
LIDAR_BLOCKED_M=0.35
# 側方セクタで「車体幅が通る開口」と見なす円錐の半角 [deg]
LIDAR_CONE_DEG=12
# FRONT は ±この角度 [deg] の最小距離
LIDAR_FRONT_HALF_DEG=20
# LEFT / RIGHT が見る角度範囲 [deg]
LIDAR_SIDE_MIN_DEG=20
LIDAR_SIDE_MAX_DEG=85

# ---- 回避コントローラ (Jevより下位) ---------------------------------------
# 正面がこれ未満なら推論を待たず後退する安全反射 [m]
AVOID_REFLEX_M=0.22
AVOID_REFLEX_HOLD=0.6
# ゴール到達と見なす距離 [m]
AVOID_GOAL_TOL=0.25
AVOID_SCAN_DT=0.1
# 表示更新周期 [s]。0.1にすると描画が重くJevのレイテンシが倍近くなる(実測)
AVOID_HUD_DT=0.2
# FORWARD時のゴール向き合わせ: 方位1degあたりの旋回指令と、その上限
AVOID_YAW_GAIN=0.0333
AVOID_YAW_MAX=0.4
# 旋回/後退を最低これだけ続ける [s] (毎周期の上書きによる左右のがたつき防止)
AVOID_COMMIT=1.0
# 迂回旋回のあとゴール追従を切って直進する秒数 [s] (リミットサイクル防止)
AVOID_ESCAPE=2.0
# この秒数のあいだにこの距離も進めなければ STUCK として終了
AVOID_STUCK_WIN=35
AVOID_STUCK_M=0.15
# 制限時間 [s] (0 = Ctrl+C まで無限)
AVOID_DURATION=180
# GUIのビーム描画の間引き (1=61本全部描く)
AVOID_RAY_STEP=2
# 予測軌跡(太い弧)を何秒先まで描くか / その分割数 / 軌跡線を伸ばす最小移動量[m]
HUD_ARC_T=1.6
HUD_ARC_SEG=10
HUD_TRAIL_MIN=0.02

# ---- GUIオーバレイ (画面右上の黒パネル) ------------------------------------
# 文字が小さい/大きいときは、まずこれだけ動かせば全体が相似に変わる
HUD_SCALE=1.0
# パネルまでのカメラ距離 [m]。一定に保つのでズームしても見た目の大きさは不変
HUD_PANEL_DIST=0.6
# 以下は画面の半幅・半高を1とした比率 (HUD_PANEL_W=0.95 なら画面幅の約48%)
HUD_TEXT_SIZE=1.0
HUD_PANEL_W=0.95
HUD_LINE_H=0.065
HUD_MARGIN=0.02
HUD_PAD=0.013
# 1行目をパネル上端から何行ぶん下げるか。小さくすると上端が見切れる
HUD_TEXT_DROP=1.05

# ---- コース ----------------------------------------------------------------
# default / slalom / wall / empty / random  (定義は conf/courses.json)
COURSE=default
COURSE_SEED=0
COURSE_N_OBSTACLES=5

# ---- GUIの初期カメラ -------------------------------------------------------
# 回避シミュ (距離[m] / ヨー[deg] / ピッチ[deg] / 注視点[m])
CAM_DIST=2.0
CAM_YAW=50
CAM_PITCH=-38
CAM_TARGET_X=1.2
CAM_TARGET_Y=0.0
CAM_TARGET_Z=0.1
# 歩容のみ (service/simulate.py)
GAIT_CAM_DIST=0.6
GAIT_CAM_YAW=40
GAIT_CAM_PITCH=-25

# ---- 歩容 ------------------------------------------------------------------
GAIT_FREQ=1.4
GAIT_MAX_STRIDE=55.0
GAIT_MAX_SIDE=26.0
# その場旋回の中心 (ボディ座標X) [mm]。脚配置から決まる値で通常は触らない
GAIT_TURN_CENTER_X=4.55

# ---- サーボ (Dynamixel XL330-M288-T @5V) -----------------------------------
SERVO_TORQUE=0.45
SERVO_VEL=10.8
SERVO_POSITION_GAIN=0.35

# ---- 物理シミュレーション --------------------------------------------------
SIM_RATE_HZ=480
SIM_SOLVER_ITERATIONS=150
SIM_SETTLE_T=0.8
SIM_LOOP_MAX_FORCE=1200
SIM_GRAVITY=-9.81
# 初期配置の浮かし量 [m]
SIM_SPAWN_Z=0.003
# 各リンクのダンピングと慣性の下限 (軽量リンク+閉ループの発散対策。下げると壊れる)
SIM_DAMPING=0.01
SIM_MIN_INERTIA=1e-4
GROUND_FRICTION=1.0
ROBOT_FRICTION=0.9

# ---- パス (通常は触らない。リポジトリ直下からの相対パスでも絶対パスでも可) --
CONF_DIR=conf
MESH_DIR=meshes
ROBOT_URDF=conf/quadruped.urdf
LEG_PARAMS=conf/leg_params.json
LOOP_CONSTRAINTS=conf/loop_constraints.json
COURSES_FILE=conf/courses.json

# ---- メッシュ再生成ツール (service/waist_build2.py, service/make_urdf.py) --
# 元STLと出力先。通常の実行では不要
STL_SRC_V1=stl/四足ロボット.stl
STL_SRC_V2=stl/四足ロボット2.stl
BUILD_OUT_DIR=build
# make_urdf.py が URDF に書くメッシュの相対パス (conf/ から見て)
URDF_MESH_PREFIX=../meshes
